# Local Edge Function env (gitignored as supabase/functions/.env).
# Never set AUTH_ALLOW_TEST_OTP on production secrets.

AUTH_ALLOW_TEST_OTP=true
AUTH_TEST_OTP_CODE=555555

# Twilio credentials are optional for test OTP. Copy from .env.local if you
# also need real SMS against a remote Verify service from local serve.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=
